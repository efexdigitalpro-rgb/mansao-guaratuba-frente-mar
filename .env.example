# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# E-mail de destino das propostas (mantido apenas no servidor, nunca exposto ao visitante)
PROPOSAL_DESTINATION_EMAIL="imoveisgrupolrv@gmail.com"

# Opção 1 (Recomendada e Gratuita): Gmail SMTP com Senha de App (16 caracteres)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Opção 2: Servidor SMTP genérico
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Opção 3 (Gratuita via API HTTPS): Resend (resend.com)
RESEND_API_KEY=""
RESEND_FROM="Mansão Guaratuba <onboarding@resend.dev>"

# Opção 4 (Gratuita via API HTTPS, 250/mês sem DNS): Web3Forms (web3forms.com)
WEB3FORMS_ACCESS_KEY=""

# Opção 5 (Gratuita via HTTP): Formspree (formspree.io)
FORMSPREE_ENDPOINT=""

# Opção 6: Webhook HTTP (ex.: Google Apps Script, Make, n8n)
EMAIL_WEBHOOK_URL=""

# Opção 7 (Fallback): Token anônimo do FormSubmit
FORMSUBMIT_TOKEN=""

